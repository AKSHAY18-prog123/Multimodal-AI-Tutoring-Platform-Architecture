# Environment Configuration
APP_NAME="SynapseTutor AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite WAL mode + AsyncSQLAlchemy)
DATABASE_URL="sqlite+aiosqlite:///./storage/db/tutor.db"
CHROMA_PERSIST_DIRECTORY="./storage/db/chroma"

# ==============================================================================
# AI Provider Configuration (Choose one of the 3 modes below):
# Mode 1: Google Gemini (Free Tier / Pro) - Recommended for best quality
# Mode 2: Local Ollama (Completely local, offline, no API key needed)
# Mode 3: Mock (Offline testing with zero keys and zero installations)
# ==============================================================================
LLM_PROVIDER="gemini"          # 'gemini', 'ollama', or 'mock'
VISION_PROVIDER="gemini"       # 'gemini', 'ollama', or 'mock'
EMBEDDING_PROVIDER="local"     # 'local' uses sentence-transformers/MiniLM
RERANKER_PROVIDER="local"      # 'local' uses FlashRank

# --- MODE 1: Google Gemini (Get free key at: https://aistudio.google.com) ---
# If LLM_PROVIDER="gemini", paste your free Gemini API key below:
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# --- MODE 2: OpenRouter (Get key at: https://openrouter.ai) ---
# Set LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- MODE 3: Local Ollama (For local offline models) ---
# Set LLM_PROVIDER="ollama" and VISION_PROVIDER="ollama" above:
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_VISION_MODEL="llama3.2-vision"

# --- MODE 4: Mock / Offline Testing ---
# If GEMINI_API_KEY is left empty and LLM_PROVIDER="gemini", the system automatically
# falls back to Mock provider so anyone can test the full platform immediately.


# Storage paths
STORAGE_DIR="./storage"
UPLOAD_DIR="./storage/uploads"
PROCESSED_DIR="./storage/processed"

# Security & CORS
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'
API_V1_PREFIX="/api/v1"
